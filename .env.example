# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is git-ignored, and .claude/hooks/protect_sensitive_files.py
# blocks Claude Code from reading/editing it directly (see .claude/hooks/README.md).

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (docs/architecture.md § 7, § 15) ---
# Default assumes the `api` service runs inside docker-compose, talking to the
# `db` service over the internal Docker network (see docker-compose.yml).
# Running the API directly on the host instead (e.g. `make dev`, no Docker),
# use: postgresql+psycopg://banking:banking@localhost:5433/banking_ai
# (5433 is the host-mapped port — chosen to avoid clashing with a local
# PostgreSQL install already using the default 5432).
DATABASE_URL=postgresql+psycopg://banking:banking@db:5432/banking_ai
VECTOR_DATABASE_URL=postgresql+psycopg://banking:banking@db:5432/banking_ai

# --- LLM (docs/architecture.md § 15, .claude/rules/ai-agents.md) ---
# LLM_MODE=mock is REQUIRED for tests/CI/demos — must run with no external API key.
# Set LLM_MODE=live only for local manual testing against a real provider.
LLM_MODE=mock
LLM_PROVIDER=anthropic
LLM_API_KEY=${LLM_API_KEY}
MODEL_NAME=

# --- Messaging (optional — only used once a phase needs event processing) ---
KAFKA_BROKERS=

# --- Observability ---
OTEL_ENDPOINT=
